# Core -> Supabase Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>
SPRING_DATASOURCE_MAX_POOL_SIZE=2
SPRING_DATASOURCE_MIN_IDLE=0
SPRING_DATASOURCE_CONN_TIMEOUT_MS=30000
SPRING_DATASOURCE_IDLE_TIMEOUT_MS=10000
SPRING_DATASOURCE_MAX_LIFETIME_MS=300000

# Frontend API target
# Keep /api to route through the core service, or set Supabase Edge Functions URL directly.
VITE_API_BASE_URL=/api
VITE_SUPABASE_FUNCTIONS_URL=
