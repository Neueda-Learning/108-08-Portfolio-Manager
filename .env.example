# Docker Compose overrides (all have working defaults - this file is optional)
# Copy to .env and tweak only if you need non-default credentials.

# MySQL
DB_NAME=portfoliom_db
DB_USERNAME=portfoliom
DB_PASSWORD=portfoliom
DB_ROOT_PASSWORD=portfoliom_root

# Backend security (override for anything beyond local dev)
